{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "StackExchange.Redis": "Warning"
    }
  },
  "PilahDok": {
    "MaxUploadBytes": 52428800,
    "MaxZipEntries": 2048,
    "MaxUncompressedBytes": 209715200,
    "MaxCompressionRatio": 100,
    "JobTtlMinutes": 60,
    "DownloadGraceMinutes": 10,
    "ProcessingTimeoutSeconds": 300,
    "RequestTimeoutSeconds": 30,
    "UploadTimeoutSeconds": 120,
    "CleanupIntervalSeconds": 60,
    "RateLimitPerMinute": 30,
    "StorageRoot": "/tmp/pilahdok/jobs",
    "RedisConnection": "redis:6379,abortConnect=false",
    "AllowedOrigins": ["http://localhost:3000"],
    "AntivirusMode": "disabled",
    "ClamAvHost": "clamav",
    "ClamAvPort": 3310,
    "VisualPaginationEnabled": false
  }
}
