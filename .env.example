# Salin sebagai .env untuk Docker Compose.
PILAHDOK_MAX_UPLOAD_BYTES=52428800
PILAHDOK_MAX_ZIP_ENTRIES=2048
PILAHDOK_MAX_UNCOMPRESSED_BYTES=209715200
PILAHDOK_MAX_COMPRESSION_RATIO=100
PILAHDOK_JOB_TTL_MINUTES=60
PILAHDOK_DOWNLOAD_GRACE_MINUTES=10
PILAHDOK_PROCESSING_TIMEOUT_SECONDS=300
PILAHDOK_REQUEST_TIMEOUT_SECONDS=30
PILAHDOK_UPLOAD_TIMEOUT_SECONDS=120
PILAHDOK_CLEANUP_INTERVAL_SECONDS=60
PILAHDOK_RATE_LIMIT_PER_MINUTE=30
PILAHDOK_ALLOWED_ORIGINS=http://localhost:3000
PILAHDOK_ANTIVIRUS_MODE=disabled
PILAHDOK_CLAMAV_HOST=clamav
PILAHDOK_CLAMAV_PORT=3310
PILAHDOK_VISUAL_PAGINATION_ENABLED=false
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
